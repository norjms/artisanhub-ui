{
  "name": "artisanhub-ui",
  "version": "0.1.0",
  "description": "The shared look of every ArtisanHub app: design values, CSS, Svelte components, and generated values for Flutter and C++.",
  "license": "MIT",
  "author": "James Norman",
  "type": "module",
  "svelte": "./src/lib/index.js",
  "exports": {
    ".": { "svelte": "./src/lib/index.js", "default": "./src/lib/index.js" },
    "./theme.css": "./dist/theme.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./base.css": "./src/lib/base.css",
    "./fonts.css": "./src/lib/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./themes": "./src/lib/themes.js"
  },
  "files": ["dist", "src/lib", "tokens", "LICENSE", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "svelte-check --workspace src --threshold error",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "gallery": "vite build gallery"
  },
  "peerDependencies": { "svelte": "^5.0.0" },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/manrope": "^5.2.5",
    "@fontsource/sora": "^5.2.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "playwright": "^1.55.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
